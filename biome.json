{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": "off",
      "complexity": {
        "useLiteralKeys": "off",
        "noUselessSwitchCase": "off",
        "useArrowFunction": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useExportType": "off",
        "useExponentiationOperator": "off",
        "useTemplate": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "d3": "Use d3 sub-packages (d3-scale, d3-array, d3-shape, d3-zoom, d3-time-format, d3-format) - never the umbrella."
            },
            "patterns": [
              {
                "group": ["d3/*"],
                "message": "Use d3 sub-packages directly (d3-scale, d3-array, ...) - not d3/<name>."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noApproximativeNumericConstant": "off",
        "noArrayIndexKey": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "test/**",
        "src/**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "vite.config.ts",
        "vitest.config.ts",
        ".storybook/**",
        "bench/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/solid/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off"
          }
        }
      }
    }
  ]
}
